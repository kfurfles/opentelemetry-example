{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run grpc:generate && NODE_OPTIONS='-r ./utils/telemetry/Instrumentation.js' next dev",
    "build": "next build",
    "start": "node --require ./Instrumentation.js server.js",
    "lint": "next lint",
    "cy:open": "cypress open",
    "grpc:generate": "mkdir -p ./protos && protoc -I ./pb  --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_opt=esModuleInterop=true --ts_proto_out=./protos --ts_proto_opt=outputServices=grpc-js demo.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/auto-instrumentations-web": "0.67.0",
    "@opentelemetry/context-zone": "1.30.1",
    "@opentelemetry/core": "1.30.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/resource-detector-alibaba-cloud": "0.37.0",
    "@opentelemetry/resource-detector-aws": "1.12.0",
    "@opentelemetry/resource-detector-container": "0.8.13",
    "@opentelemetry/resource-detector-gcp": "0.57.0",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-metrics": "1.30.1",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@opentelemetry/sdk-trace-node": "1.30.1",
    "@opentelemetry/sdk-trace-web": "1.30.1",
    "@tanstack/react-query": "4.44.0",
    "cookies-next": "2.1.2",
    "currency-symbol-map": "5.1.0",
    "dotenv": "16.6.1",
    "dotenv-expand": "10.0.0",
    "next": "12.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.4",
    "styled-components": "6.5.3",
    "ts-proto": "1.181.2",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/uuid": "9.0.8",
    "@types/styled-components": "5.1.36",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "cypress": "10.11.0",
    "eslint": "8.57.1",
    "eslint-config-next": "13.5.11",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "openapi-typescript": "6.7.6",
    "typescript": "5.9.3"
  }
}
